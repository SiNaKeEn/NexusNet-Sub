#!/usr/bin/env bash
set -euo pipefail

REPO_RAW="https://raw.githubusercontent.com/SiNaKeEn/NexusNet-Sub/Themes"
RED='\033[0;31m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
NC='\033[0m'

need_root() {
  if [[ "${EUID}" -ne 0 ]]; then
    echo -e "${RED}Error: run as root (sudo nexusnetsub)${NC}"
    exit 1
  fi
}

download() {
  local url="$1" dest="$2"
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL "$url" -o "$dest"
  elif command -v wget >/dev/null 2>&1; then
    wget -q -O "$dest" "$url"
  else
    echo -e "${RED}curl/wget not found${NC}"; exit 1
  fi
}

install_xui_theme() {
  local theme="$1"
  local dir="/etc/x-ui/sub"
  local file="${dir}/sub.html"
  mkdir -p "$dir"
  download "${REPO_RAW}/xui-${theme}.html" "$file"
  chmod 644 "$file"
  echo -e "${GREEN}Installed 3x-ui theme: ${theme} -> ${file}${NC}"
}

install_pg_theme() {
  local theme="$1"
  local dir="/var/lib/pasarguard/templates/subscription"
  local file="${dir}/index.html"
  local env="/opt/pasarguard/.env"
  mkdir -p "$dir"
  download "${REPO_RAW}/pasarguard-${theme}.html" "$file"
  chmod 644 "$file"
  mkdir -p "$(dirname "$env")"; touch "$env"
  if grep -q '^CUSTOM_TEMPLATES_DIRECTORY=' "$env" 2>/dev/null; then
    sed -i 's|^CUSTOM_TEMPLATES_DIRECTORY=.*|CUSTOM_TEMPLATES_DIRECTORY="/var/lib/pasarguard/templates/"|' "$env"
  else
    echo 'CUSTOM_TEMPLATES_DIRECTORY="/var/lib/pasarguard/templates/"' >> "$env"
  fi
  if grep -q '^SUBSCRIPTION_PAGE_TEMPLATE=' "$env" 2>/dev/null; then
    sed -i 's|^SUBSCRIPTION_PAGE_TEMPLATE=.*|SUBSCRIPTION_PAGE_TEMPLATE="subscription/index.html"|' "$env"
  else
    echo 'SUBSCRIPTION_PAGE_TEMPLATE="subscription/index.html"' >> "$env"
  fi
  echo -e "${GREEN}Installed PasarGuard theme: ${theme} -> ${file}${NC}"
  if command -v pasarguard >/dev/null 2>&1; then pasarguard restart || true; fi
}

remove_xui() {
  rm -f /etc/x-ui/sub/sub.html
  echo -e "${GREEN}Removed 3x-ui custom sub.html${NC}"
}

remove_pg() {
  rm -f /var/lib/pasarguard/templates/subscription/index.html
  echo -e "${GREEN}Removed PasarGuard subscription template${NC}"
  if command -v pasarguard >/dev/null 2>&1; then pasarguard restart || true; fi
}

status() {
  echo -e "${CYAN}=== NexusNet Sub Status ===${NC}"
  if [[ -f /etc/x-ui/sub/sub.html ]]; then
    echo -e "3x-ui theme: ${GREEN}installed${NC} ($(wc -c </etc/x-ui/sub/sub.html) bytes)"
  else
    echo -e "3x-ui theme: ${YELLOW}not installed${NC}"
  fi
  if [[ -f /var/lib/pasarguard/templates/subscription/index.html ]]; then
    echo -e "PasarGuard theme: ${GREEN}installed${NC}"
  else
    echo -e "PasarGuard theme: ${YELLOW}not installed${NC}"
  fi
}

menu() {
  clear
  echo -e "${CYAN}"
  cat << 'B'
  ========================================
         NexusNet Sub  Manager
  ========================================
B
  echo -e "${NC}"
  echo "  1) Install / Update  - 3x-ui  NexusNet theme"
  echo "  2) Install / Update  - 3x-ui  Default theme"
  echo "  3) Install / Update  - PasarGuard  NexusNet theme"
  echo "  4) Install / Update  - PasarGuard  Default theme"
  echo "  5) Remove 3x-ui theme"
  echo "  6) Remove PasarGuard theme"
  echo "  7) Status"
  echo "  8) Exit"
  echo -n "Choice [1-8]: "
  read -r c
  case "$c" in
    1) install_xui_theme nexusnet ;;
    2) install_xui_theme default ;;
    3) install_pg_theme nexusnet ;;
    4) install_pg_theme default ;;
    5) remove_xui ;;
    6) remove_pg ;;
    7) status ;;
    8) exit 0 ;;
    *) echo -e "${RED}Invalid${NC}"; exit 1 ;;
  esac
}

need_root
menu
