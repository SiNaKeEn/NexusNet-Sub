#!/usr/bin/env bash
# =============================================================================
#  NexusNet Sub Manager  v3.0.0
#  Professional subscription theme manager for 3x-ui & PasarGuard
#  Repo: https://github.com/SiNaKeEn/NexusNet-Sub  (branch: Template)
# =============================================================================
set -euo pipefail

REPO_RAW="https://raw.githubusercontent.com/SiNaKeEn/NexusNet-Sub/Template"
REPO_URL="https://github.com/SiNaKeEn/NexusNet-Sub"
VERSION="3.0.0"

RED='\033[0;31m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

CFG_DIR="/etc/nxt-sub"
CFG_FILE="${CFG_DIR}/config"
XUI_THEME="/etc/x-ui/sub/sub.html"
PG_THEME="/var/lib/pasarguard/templates/subscription/index.html"
PG_ENV="/opt/pasarguard/.env"

# ── helpers ──────────────────────────────────────────────────────────────────
need_root() {
  if [[ "${EUID}" -ne 0 ]]; then
    echo -e "${RED}Error: run as root → sudo nxt-sub${NC}"
    exit 1
  fi
}

dl() {
  local url="$1" dest="$2"
  local tmp
  tmp=$(mktemp)
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL --connect-timeout 15 --max-time 60 "$url" -o "$tmp" || { rm -f "$tmp"; return 1; }
  elif command -v wget >/dev/null 2>&1; then
    wget -q --timeout=30 -O "$tmp" "$url" || { rm -f "$tmp"; return 1; }
  else
    echo -e "${RED}curl or wget is required${NC}"
    return 1
  fi
  mv -f "$tmp" "$dest"
}

backup_file() {
  local f="$1"
  if [[ -f "$f" ]]; then
    local bak="${f}.bak.$(date +%Y%m%d%H%M%S)"
    cp -a "$f" "$bak"
    echo -e "  ${DIM}Backup → ${bak}${NC}"
  fi
}

load_cfg() {
  PROFILE_TITLE=""; SUPPORT_URL=""; RENEW_URL=""; TELEGRAM_BOT=""
  [[ -f "$CFG_FILE" ]] || return 0
  local key value
  while IFS='=' read -r key value || [[ -n "${key:-}" ]]; do
    case "$key" in
      PROFILE_TITLE_B64) PROFILE_TITLE=$(printf '%s' "$value" | base64 -d 2>/dev/null || true) ;;
      SUPPORT_URL_B64) SUPPORT_URL=$(printf '%s' "$value" | base64 -d 2>/dev/null || true) ;;
      RENEW_URL_B64) RENEW_URL=$(printf '%s' "$value" | base64 -d 2>/dev/null || true) ;;
      TELEGRAM_BOT_B64) TELEGRAM_BOT=$(printf '%s' "$value" | base64 -d 2>/dev/null || true) ;;
      # Read legacy plain assignments as data only; never execute a config file.
      PROFILE_TITLE|SUPPORT_URL|RENEW_URL|TELEGRAM_BOT)
        value="${value%$'\r'}"; value="${value#\"}"; value="${value%\"}"; value="${value#\'}"; value="${value%\'}"
        case "$key" in PROFILE_TITLE) PROFILE_TITLE="$value";; SUPPORT_URL) SUPPORT_URL="$value";; RENEW_URL) RENEW_URL="$value";; TELEGRAM_BOT) TELEGRAM_BOT="$value";; esac ;;
    esac
  done < "$CFG_FILE"
  if [[ -z "${RENEW_URL:-}" && -n "${TELEGRAM_BOT:-}" ]]; then local bot="${TELEGRAM_BOT#@}"; RENEW_URL="https://t.me/${bot}"; fi
  if [[ -z "${SUPPORT_URL:-}" && -n "${TELEGRAM_BOT:-}" ]]; then local bot2="${TELEGRAM_BOT#@}"; SUPPORT_URL="https://t.me/${bot2}"; fi
}

save_cfg() {
  mkdir -p "$CFG_DIR"
  {
    echo "# NexusNet Sub config — managed by nxt-sub; values are base64 data, never shell code"
    printf 'PROFILE_TITLE_B64=%s\n' "$(printf '%s' "${PROFILE_TITLE:-}" | base64 | tr -d '\n')"
    printf 'SUPPORT_URL_B64=%s\n' "$(printf '%s' "${SUPPORT_URL:-}" | base64 | tr -d '\n')"
    printf 'RENEW_URL_B64=%s\n' "$(printf '%s' "${RENEW_URL:-}" | base64 | tr -d '\n')"
    printf 'TELEGRAM_BOT_B64=%s\n' "$(printf '%s' "${TELEGRAM_BOT:-}" | base64 | tr -d '\n')"
  } > "$CFG_FILE"
  chmod 600 "$CFG_FILE"
}

inject_theme() {
  local file="$1"
  load_cfg
  [[ -f "$file" ]] || return 1

  # Base64 is safe to inject into sed and decoded by the browser as UTF-8.
  b64() { printf '%s' "$1" | base64 | tr -d '\n'; }

  local pt su ru
  pt=$(b64 "${PROFILE_TITLE:-}")
  su=$(b64 "${SUPPORT_URL:-}")
  ru=$(b64 "${RENEW_URL:-}")

  local tmp
  tmp=$(mktemp)
  sed -E \
    -e "s|profileTitle:decodeConfig\(\"[A-Za-z0-9+/=]*\"\)|profileTitle:decodeConfig(\"${pt}\")|" \
    -e "s|supportUrl:decodeConfig\(\"[A-Za-z0-9+/=]*\"\)|supportUrl:decodeConfig(\"${su}\")|" \
    -e "s|renewUrl:decodeConfig\(\"[A-Za-z0-9+/=]*\"\)|renewUrl:decodeConfig(\"${ru}\")|" \
    "$file" > "$tmp"
  mv -f "$tmp" "$file"
}

banner() {
  clear 2>/dev/null || true
  echo -e "${CYAN}${BOLD}"
  echo "  ╔══════════════════════════════════════════════╗"
  echo "  ║           NexusNet Sub Manager               ║"
  echo "  ║              v${VERSION}  •  Template                ║"
  echo "  ╚══════════════════════════════════════════════╝"
  echo -e "${NC}"
}

pause() {
  echo ""
  read -rp "  Press Enter to continue..."
}

# ── install / update ─────────────────────────────────────────────────────────
do_install_xui() {
  echo -e "${CYAN}→ Installing theme for 3x-ui / Sanaei...${NC}"
  mkdir -p /etc/x-ui/sub
  backup_file "$XUI_THEME"
  echo -e "  ${YELLOW}Downloading xui-nexusnet.html...${NC}"
  if ! dl "${REPO_RAW}/xui-nexusnet.html" "$XUI_THEME"; then
    echo -e "${RED}Download failed${NC}"
    return 1
  fi
  chmod 644 "$XUI_THEME"
  inject_theme "$XUI_THEME"
  echo -e "${GREEN}✓ Theme installed → ${XUI_THEME}${NC}"
  echo -e "  ${DIM}Panel path: Sub Theme Directory = /etc/x-ui/sub/${NC}"
}

do_install_pg() {
  echo -e "${CYAN}→ Installing theme for PasarGuard...${NC}"
  if [[ -f "$PG_ENV" ]]; then
    local configured_root configured_template
    configured_root=$(grep '^CUSTOM_TEMPLATES_DIRECTORY=' "$PG_ENV" | tail -n1 | cut -d= -f2- | sed 's/^"//;s/"$//;s/^\x27//;s/\x27$//')
    configured_template=$(grep '^SUBSCRIPTION_PAGE_TEMPLATE=' "$PG_ENV" | tail -n1 | cut -d= -f2- | sed 's/^"//;s/"$//;s/^\x27//;s/\x27$//')
    [[ -z "$configured_template" ]] && configured_template="subscription/index.html"
    [[ -n "$configured_root" ]] && PG_THEME="${configured_root%/}/${configured_template#/}"
  fi
  mkdir -p "$(dirname "$PG_THEME")"
  backup_file "$PG_THEME"
  echo -e "  ${YELLOW}Downloading pasarguard-nexusnet.html...${NC}"
  if ! dl "${REPO_RAW}/pasarguard-nexusnet.html" "$PG_THEME"; then
    echo -e "${RED}Download failed${NC}"
    return 1
  fi
  chmod 644 "$PG_THEME"
  inject_theme "$PG_THEME"

  mkdir -p "$(dirname "$PG_ENV")"
  touch "$PG_ENV"
  if ! grep -q '^CUSTOM_TEMPLATES_DIRECTORY=' "$PG_ENV" 2>/dev/null; then
    echo 'CUSTOM_TEMPLATES_DIRECTORY="/var/lib/pasarguard/templates/"' >> "$PG_ENV"
  fi
  if ! grep -q '^SUBSCRIPTION_PAGE_TEMPLATE=' "$PG_ENV" 2>/dev/null; then
    printf '%s\n' 'SUBSCRIPTION_PAGE_TEMPLATE="subscription/index.html"' >> "$PG_ENV"
  fi

  local restarted=0
  if command -v pasarguard >/dev/null 2>&1; then
    if pasarguard restart; then restarted=1; fi
  fi
  if [[ $restarted -eq 0 ]] && command -v docker >/dev/null 2>&1 && [[ -d /opt/pasarguard ]]; then
    if (cd /opt/pasarguard && docker compose ps --services 2>/dev/null | grep -qx 'pasarguard'); then
      if (cd /opt/pasarguard && docker compose restart pasarguard); then restarted=1; fi
    fi
  fi
  if [[ $restarted -eq 1 ]]; then
    echo -e "${GREEN}✓ PasarGuard restart completed${NC}"
  else
    echo -e "${YELLOW}! Theme file installed, but automatic restart was not confirmed.${NC}"
    echo -e "  ${YELLOW}Verify the container mount and restart PasarGuard manually.${NC}"
  fi
  echo -e "${GREEN}✓ Theme installed → ${PG_THEME}${NC}"
}

do_update() {
  local updated=0
  if [[ -f "$XUI_THEME" ]]; then
    echo -e "${CYAN}Updating 3x-ui theme...${NC}"
    do_install_xui && updated=1
  fi
  if [[ -f "$PG_THEME" ]]; then
    echo -e "${CYAN}Updating PasarGuard theme...${NC}"
    do_install_pg && updated=1
  fi
  if [[ $updated -eq 0 ]]; then
    echo -e "${YELLOW}No theme installed yet. Use Install first.${NC}"
  else
    echo -e "${GREEN}✓ Update finished${NC}"
  fi
}

# ── settings ─────────────────────────────────────────────────────────────────
settings_menu() {
  while true; do
    load_cfg
    banner
    echo -e "  ${BOLD}Settings${NC}"
    echo -e "  ${DIM}────────────────────────────────────────${NC}"
    echo -e "  Profile title  : ${GREEN}${PROFILE_TITLE:-'(empty)'}${NC}"
    echo -e "  Telegram bot   : ${GREEN}${TELEGRAM_BOT:-'(empty)'}${NC}"
    echo -e "  Support URL    : ${GREEN}${SUPPORT_URL:-'(empty)'}${NC}"
    echo -e "  Renew URL      : ${GREEN}${RENEW_URL:-'(empty)'}${NC}"
    echo -e "  ${DIM}────────────────────────────────────────${NC}"
    echo ""
    echo "  1) Set Profile Title"
    echo "  2) Set Telegram Bot (@username)"
    echo "  3) Set Support URL"
    echo "  4) Set Renew URL"
    echo "  5) Apply settings to installed themes"
    echo "  0) Back"
    echo ""
    read -rp "  Choice: " ch
    case "$ch" in
      1)
        read -rp "  Profile title: " PROFILE_TITLE
        save_cfg
        echo -e "${GREEN}Saved${NC}"
        sleep 0.8
        ;;
      2)
        read -rp "  Telegram bot (e.g. @MyBot or MyBot): " TELEGRAM_BOT
        TELEGRAM_BOT="${TELEGRAM_BOT#@}"
        save_cfg
        echo -e "${GREEN}Saved${NC}"
        sleep 0.8
        ;;
      3)
        read -rp "  Support URL: " SUPPORT_URL
        save_cfg
        echo -e "${GREEN}Saved${NC}"
        sleep 0.8
        ;;
      4)
        read -rp "  Renew URL: " RENEW_URL
        save_cfg
        echo -e "${GREEN}Saved${NC}"
        sleep 0.8
        ;;
      5)
        echo -e "${CYAN}Applying...${NC}"
        [[ -f "$XUI_THEME" ]] && inject_theme "$XUI_THEME" && echo -e "  ${GREEN}3x-ui OK${NC}"
        [[ -f "$PG_THEME"  ]] && inject_theme "$PG_THEME"  && echo -e "  ${GREEN}PasarGuard OK${NC}"
        echo -e "${GREEN}Done${NC}"
        sleep 1
        ;;
      0) return ;;
      *) echo -e "${RED}Invalid${NC}"; sleep 0.6 ;;
    esac
  done
}

# ── restore ──────────────────────────────────────────────────────────────────
restore_menu() {
  banner
  echo -e "  ${BOLD}Restore from backup${NC}"
  echo ""
  local found=0
  if ls /etc/x-ui/sub/sub.html.bak.* 1>/dev/null 2>&1; then
    echo -e "  ${CYAN}3x-ui backups:${NC}"
    ls -1t /etc/x-ui/sub/sub.html.bak.* 2>/dev/null | head -8 | nl -w2 -s') '
    found=1
  fi
  if ls /var/lib/pasarguard/templates/subscription/index.html.bak.* 1>/dev/null 2>&1; then
    echo -e "  ${CYAN}PasarGuard backups:${NC}"
    ls -1t /var/lib/pasarguard/templates/subscription/index.html.bak.* 2>/dev/null | head -8 | nl -w2 -s') '
    found=1
  fi
  if [[ $found -eq 0 ]]; then
    echo -e "  ${YELLOW}No backups found${NC}"
    pause
    return
  fi
  echo ""
  read -rp "  Full path of backup to restore (or Enter to cancel): " bak
  if [[ -z "$bak" || ! -f "$bak" ]]; then
    echo -e "${YELLOW}Cancelled${NC}"
    sleep 0.8
    return
  fi
  if [[ "$bak" == *"/sub/sub.html.bak."* ]]; then
    cp -a "$bak" "$XUI_THEME"
    echo -e "${GREEN}✓ Restored 3x-ui theme${NC}"
  elif [[ "$bak" == *"subscription/index.html.bak."* ]]; then
    cp -a "$bak" "$PG_THEME"
    command -v pasarguard >/dev/null 2>&1 && pasarguard restart 2>/dev/null || true
    echo -e "${GREEN}✓ Restored PasarGuard theme${NC}"
  else
    echo -e "${RED}Unknown backup path${NC}"
  fi
  pause
}

# ── status ───────────────────────────────────────────────────────────────────
show_status() {
  banner
  echo -e "  ${BOLD}Status${NC}"
  echo -e "  ${DIM}────────────────────────────────────────${NC}"
  if [[ -f "$XUI_THEME" ]]; then
    local sz
    sz=$(du -h "$XUI_THEME" 2>/dev/null | cut -f1)
    echo -e "  3x-ui theme     : ${GREEN}installed${NC}  (${sz})"
  else
    echo -e "  3x-ui theme     : ${YELLOW}not installed${NC}"
  fi
  if [[ -f "$PG_THEME" ]]; then
    local sz2
    sz2=$(du -h "$PG_THEME" 2>/dev/null | cut -f1)
    echo -e "  PasarGuard theme: ${GREEN}installed${NC}  (${sz2})"
  else
    echo -e "  PasarGuard theme: ${YELLOW}not installed${NC}"
  fi
  if command -v nxt-sub >/dev/null 2>&1; then
    echo -e "  CLI             : ${GREEN}$(command -v nxt-sub)${NC}"
  else
    echo -e "  CLI             : ${YELLOW}/usr/local/bin/nxt-sub (not in PATH?)${NC}"
  fi
  load_cfg
  echo -e "  ${DIM}────────────────────────────────────────${NC}"
  echo -e "  Profile title   : ${PROFILE_TITLE:-—}"
  echo -e "  Telegram bot    : ${TELEGRAM_BOT:-—}"
  echo -e "  Support URL     : ${SUPPORT_URL:-—}"
  echo -e "  Renew URL       : ${RENEW_URL:-—}"
  echo -e "  Config file     : ${CFG_FILE}"
  echo -e "  Version         : ${GREEN}${VERSION}${NC}"
  pause
}

# ── uninstall ────────────────────────────────────────────────────────────────
do_uninstall() {
  banner
  echo -e "  ${BOLD}${RED}Uninstall${NC}"
  echo ""
  echo "  1) Remove 3x-ui theme only"
  echo "  2) Remove PasarGuard theme only"
  echo "  3) Full uninstall (themes + CLI + config)"
  echo "  0) Cancel"
  echo ""
  read -rp "  Choice: " ch
  case "$ch" in
    1)
      backup_file "$XUI_THEME"
      rm -f "$XUI_THEME"
      echo -e "${GREEN}✓ 3x-ui theme removed${NC}"
      ;;
    2)
      backup_file "$PG_THEME"
      rm -f "$PG_THEME"
      command -v pasarguard >/dev/null 2>&1 && pasarguard restart 2>/dev/null || true
      echo -e "${GREEN}✓ PasarGuard theme removed${NC}"
      ;;
    3)
      backup_file "$XUI_THEME"
      backup_file "$PG_THEME"
      rm -f "$XUI_THEME" "$PG_THEME"
      rm -f /usr/local/bin/nxt-sub /usr/bin/nxt-sub /usr/local/bin/nexusnetsub
      rm -rf "$CFG_DIR"
      command -v pasarguard >/dev/null 2>&1 && pasarguard restart 2>/dev/null || true
      echo -e "${GREEN}✓ Full uninstall complete${NC}"
      echo -e "  ${DIM}(Backups of theme files kept if they existed)${NC}"
      ;;
    0) return ;;
    *) echo -e "${RED}Invalid${NC}" ;;
  esac
  pause
}

# ── about ────────────────────────────────────────────────────────────────────
show_about() {
  banner
  echo -e "  ${BOLD}About NexusNet Sub${NC}"
  echo -e "  ${DIM}────────────────────────────────────────${NC}"
  echo -e "  Version   : ${GREEN}${VERSION}${NC}"
  echo -e "  Repo      : ${REPO_URL}"
  echo -e "  Branch    : Template"
  echo -e "  Panels    : 3x-ui / Sanaei  +  PasarGuard"
  echo ""
  echo -e "  Features:"
  echo -e "    • No CDN (system fonts + SVG icons)"
  echo -e "    • Offline QR fallback"
  echo -e "    • Safe localStorage + XSS escape"
  echo -e "    • Badge: Expired / Quota / Expiring"
  echo -e "    • Liquid remaining ring"
  echo -e "    • HTTPS-only ping (privacy)"
  echo -e "    • Dual-panel + CLI config injection"
  echo -e "  ${DIM}────────────────────────────────────────${NC}"
  pause
}


# ── update manager (CLI only) ────────────────────────────────────────────────
do_update_manager() {
  echo -e "${CYAN}→ Updating nxt-sub manager (CLI only, themes unchanged)...${NC}"
  local tmp
  tmp=$(mktemp)
  if ! dl "${REPO_RAW}/nxt-sub" "$tmp"; then
    echo -e "${RED}Download failed${NC}"
    rm -f "$tmp"
    return 1
  fi
  # basic sanity: must be bash script mentioning NexusNet
  if ! head -5 "$tmp" | grep -q 'NexusNet'; then
    echo -e "${RED}Downloaded file looks invalid${NC}"
    rm -f "$tmp"
    return 1
  fi
  chmod 755 "$tmp"
  if [[ -f /usr/local/bin/nxt-sub ]]; then
    backup_file /usr/local/bin/nxt-sub
  fi
  mv -f "$tmp" /usr/local/bin/nxt-sub
  chmod 755 /usr/local/bin/nxt-sub
  cp -f /usr/local/bin/nxt-sub /usr/bin/nxt-sub 2>/dev/null || true
  chmod 755 /usr/bin/nxt-sub 2>/dev/null || true
  local ver
  ver=$(grep -m1 '^VERSION=' /usr/local/bin/nxt-sub | cut -d= -f2 | tr -d '"' || echo "?")
  echo -e "${GREEN}✓ Manager updated → v${ver}${NC}"
  echo -e "${DIM}Re-run: sudo nxt-sub${NC}"
  # re-exec new binary so menu shows new version
  exec /usr/local/bin/nxt-sub
}

# ── main menu ────────────────────────────────────────────────────────────────
main_menu() {
  while true; do
    banner
    echo -e "  ${BOLD}Main Menu${NC}"
    echo ""
    echo -e "  ${GREEN}1)${NC} Install / Reinstall  →  3x-ui"
    echo -e "  ${GREEN}2)${NC} Install / Reinstall  →  PasarGuard"
    echo -e "  ${CYAN}3)${NC} Update installed themes"
    echo -e "  ${CYAN}4)${NC} Update manager (nxt-sub only)"
    echo -e "  ${BLUE}5)${NC} Settings (title / bot / support / renew)"
    echo -e "  ${YELLOW}6)${NC} Restore from backup"
    echo -e "  ${MAGENTA}7)${NC} Status"
    echo -e "  ${RED}8)${NC} Uninstall"
    echo -e "  ${DIM}9)${NC} About"
    echo -e "  ${DIM}0)${NC} Exit"
    echo ""
    read -rp "  Choice [0-9]: " choice
    case "$choice" in
      1) do_install_xui; pause ;;
      2) do_install_pg;  pause ;;
      3) do_update;      pause ;;
      4) do_update_manager ;;
      5) settings_menu ;;
      6) restore_menu ;;
      7) show_status;    pause ;;
      8) do_uninstall;   pause ;;
      9) show_about;     pause ;;
      0) echo -e "${CYAN}Bye.${NC}"; exit 0 ;;
      *) echo -e "${RED}Invalid choice${NC}"; sleep 0.7 ;;
    esac
  done
}

# ── entry ────────────────────────────────────────────────────────────────────
need_root
main_menu
