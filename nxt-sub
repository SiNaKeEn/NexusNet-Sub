#!/usr/bin/env bash
# NexusNet Sub Manager v3.1
set -euo pipefail
VERSION="3.1"
REF="${NXT_REF:-Template}"                                   # branch / tag / commit — pin a tag or commit for production
BASE="${NXT_BASE:-https://raw.githubusercontent.com/SiNaKeEn/NexusNet-Sub/${REF}}"
RED='\033[0;31m'; GREEN='\033[0;32m'; CYAN='\033[0;36m'; YELLOW='\033[1;33m'; NC='\033[0m'
XUI_DIR="/etc/x-ui/sub";            XUI_FILE="${XUI_DIR}/sub.html"
PG_ENV="${PG_ENV:-/opt/pasarguard/.env}"
PG_DEFAULT_TPL="/var/lib/pasarguard/templates"
CFG_DIR="/etc/nxt-sub"; CFG_FILE="${CFG_DIR}/config"
MARK='NXT_CFG_BEGIN'                                          # marker that must exist in a valid theme file

die(){ echo -e "${RED}$*${NC}" >&2; exit 1; }
[[ "${EUID}" -eq 0 ]] || die "Run as root: sudo nxt-sub"
ask(){ local a; if [[ -r /dev/tty ]]; then read -r -p "$1" a </dev/tty || a=""; else read -r -p "$1" a || a=""; fi; printf '%s' "$a"; }
confirm(){ [[ "$(ask "$1 [y/N]: ")" =~ ^[Yy]$ ]]; }

# ---------- download (to temp, verify, then move) ----------
fetch(){ # url dest
  if command -v curl >/dev/null 2>&1; then curl -fsSL --retry 2 --max-time 60 "$1" -o "$2"
  elif command -v wget >/dev/null 2>&1; then wget -q -T 60 -O "$2" "$1"
  else die "curl/wget missing"; fi
}
verify_sum(){ # file name  (checks SHA256SUMS from the same ref when available)
  local sums; sums="$(mktemp)"
  if fetch "${BASE}/SHA256SUMS" "$sums" 2>/dev/null && command -v sha256sum >/dev/null 2>&1; then
    local want got; want="$(awk -v n="$2" '$2==n||$2=="*"n{print $1}' "$sums")"; got="$(sha256sum "$1" | awk '{print $1}')"
    rm -f "$sums"
    [[ -z "$want" ]] && { echo -e "${YELLOW}No checksum listed for $2 — skipped${NC}"; return 0; }
    [[ "$want" == "$got" ]] || { echo -e "${RED}Checksum mismatch for $2 — aborting${NC}"; return 1; }
    echo -e "${GREEN}Checksum OK${NC}"
  else rm -f "$sums"; echo -e "${YELLOW}Checksum file unavailable — skipped${NC}"; fi
}
get_theme(){ # name(remote) -> prints temp path ; honors LOCAL_FILE
  local tmp; tmp="$(mktemp)"
  if [[ -n "${LOCAL_FILE:-}" ]]; then cp "$LOCAL_FILE" "$tmp"
  else echo -e "${YELLOW}Downloading $1 ...${NC}" >&2; fetch "${BASE}/$1" "$tmp" || { rm -f "$tmp"; die "Download failed (set NXT_BASE=<mirror> or use --file)"; }
       verify_sum "$tmp" "$1" >&2 || { rm -f "$tmp"; exit 1; }; fi
  [[ -s "$tmp" ]] && grep -q "$MARK" "$tmp" || { rm -f "$tmp"; die "Downloaded file is not a valid NexusNet theme"; }
  printf '%s' "$tmp"
}

# ---------- config (written with %q, never evaluated as code) ----------
load_cfg(){ PROFILE_TITLE=""; SUPPORT_URL=""; RENEW_URL=""; TELEGRAM_BOT=""; ACCENT=""; LOGO_URL=""; NOTICE=""
  # shellcheck disable=SC1090
  [[ -f "$CFG_FILE" ]] && source "$CFG_FILE" 2>/dev/null || true
  local bot="${TELEGRAM_BOT#@}"
  [[ -z "$RENEW_URL"   && -n "$bot" ]] && RENEW_URL="https://t.me/${bot}"
  [[ -z "$SUPPORT_URL" && -n "$bot" ]] && SUPPORT_URL="https://t.me/${bot}"
  return 0; }
save_cfg(){ mkdir -p "$CFG_DIR"; umask 077
  { echo "# NexusNet Sub config — managed by nxt-sub"
    for k in PROFILE_TITLE SUPPORT_URL RENEW_URL TELEGRAM_BOT ACCENT LOGO_URL NOTICE; do printf '%s=%q\n' "$k" "${!k}"; done; } > "$CFG_FILE"
  chmod 600 "$CFG_FILE"; echo -e "${GREEN}Saved ${CFG_FILE}${NC}"; }
json_str(){ local s="$1"; s="${s//\\/\\\\}"; s="${s//\"/\\\"}"; s="${s//$'\n'/ }"; s="${s//$'\r'/}"; s="${s//$'\t'/ }"
  s="${s//</\\u003c}"; s="${s//>/\\u003e}"; s="${s//&/\\u0026}"; printf '"%s"' "$s"; }
url_ok(){ [[ -z "$1" || "$1" =~ ^(https?|tg)://[^[:space:]\"\<\>\\]+$ ]]; }
inject_theme(){ local file="$1"; load_cfg; [[ -f "$file" ]] || return 1
  url_ok "$SUPPORT_URL" || SUPPORT_URL=""; url_ok "$RENEW_URL" || RENEW_URL=""
  [[ "$LOGO_URL" =~ ^https://[^[:space:]\"\<\>\\]+$ ]] || LOGO_URL=""; [[ "$ACCENT" =~ ^#[0-9a-fA-F]{6}$ ]] || ACCENT=""
  local json; json="{\"profileTitle\":$(json_str "$PROFILE_TITLE"),\"supportUrl\":$(json_str "$SUPPORT_URL"),\"renewUrl\":$(json_str "$RENEW_URL"),\"accent\":$(json_str "$ACCENT"),\"logo\":$(json_str "$LOGO_URL"),\"notice\":$(json_str "$NOTICE")}"
  local tmp; tmp="$(mktemp)"
  NXT_JSON="$json" awk 'BEGIN{j=ENVIRON["NXT_JSON"]} /\/\*NXT_CFG_BEGIN\*\//{print;print "const CONFIG=" j ";";skip=1;next} /\/\*NXT_CFG_END\*\//{skip=0} !skip{print}' "$file" > "$tmp"
  grep -q 'const CONFIG=' "$tmp" || { rm -f "$tmp"; die "Config injection failed — file left untouched"; }
  cat "$tmp" > "$file"; rm -f "$tmp"; }

backup(){ local f="$1"; [[ -f "$f" ]] || return 0
  cp -a "$f" "${f}.bak.$(date +%Y%m%d%H%M%S)"; echo -e "${GREEN}Backup created${NC}"
  ls -1t "${f}".bak.* 2>/dev/null | tail -n +4 | xargs -r rm -f; }   # keep newest 3
restore_latest(){ local f="$1" b; b="$(ls -1t "${f}".bak.* 2>/dev/null | head -1 || true)"
  [[ -n "$b" ]] || { echo -e "${YELLOW}No backup for $f${NC}"; return 1; }
  cp -a "$b" "$f"; echo -e "${GREEN}Restored $b${NC}"; }
place(){ local tmp="$1" dest="$2"; mkdir -p "$(dirname "$dest")"; backup "$dest"; install -m 644 "$tmp" "$dest"; rm -f "$tmp"; inject_theme "$dest"; }

# ---------- panels ----------
install_xui(){ local tmp; tmp="$(get_theme xui-nexusnet.html)"; place "$tmp" "$XUI_FILE"
  echo -e "${GREEN}OK ${XUI_FILE}${NC}\n${CYAN}Panel → Sub Theme Directory = ${XUI_DIR}/${NC}"; }
pg_tpl_dir(){ local cur=""; [[ -f "$PG_ENV" ]] && cur="$(grep -E '^CUSTOM_TEMPLATES_DIRECTORY=' "$PG_ENV" | tail -1 | cut -d= -f2- | tr -d "\"'" || true)"
  printf '%s' "${cur:-$PG_DEFAULT_TPL}"; }
set_env(){ local k="$1" v="$2"; if grep -qE "^${k}=" "$PG_ENV" 2>/dev/null; then sed -i "s|^${k}=.*|${k}=\"${v}\"|" "$PG_ENV"; else echo "${k}=\"${v}\"" >> "$PG_ENV"; fi; }
install_pg(){ local tmp dir dest; tmp="$(get_theme pasarguard-nexusnet.html)"
  mkdir -p "$(dirname "$PG_ENV")"; touch "$PG_ENV"; dir="$(pg_tpl_dir)"; dir="${dir%/}"; dest="${dir}/subscription/index.html"
  place "$tmp" "$dest"
  backup "$PG_ENV"
  grep -qE '^CUSTOM_TEMPLATES_DIRECTORY=' "$PG_ENV" || set_env CUSTOM_TEMPLATES_DIRECTORY "${dir}/"   # never overrides your existing directory
  set_env SUBSCRIPTION_PAGE_TEMPLATE "subscription/index.html"
  command -v pasarguard >/dev/null 2>&1 && pasarguard restart || echo -e "${YELLOW}Restart PasarGuard manually${NC}"
  echo -e "${GREEN}OK ${dest}${NC}"; }
pg_file(){ printf '%s/subscription/index.html' "$(pg_tpl_dir | sed 's:/*$::')"; }

settings_menu(){ load_cfg
  echo -e "\n${CYAN}Current settings${NC} (enter = keep, '-' = clear)"
  local v
  edit(){ local name="$1" label="$2"; v="$(ask "$label [${!name:-empty}]: ")"; [[ "$v" == "-" ]] && printf -v "$name" '%s' "" || { [[ -n "$v" ]] && printf -v "$name" '%s' "$v"; }; return 0; }
  edit PROFILE_TITLE "Brand / profile title"
  v="$(ask "Telegram bot username (MyBot or @MyBot) [${TELEGRAM_BOT:-empty}]: ")"
  if [[ -n "$v" ]]; then TELEGRAM_BOT="${v#@}"; [[ -z "$SUPPORT_URL" ]] && SUPPORT_URL="https://t.me/${TELEGRAM_BOT}"; [[ -z "$RENEW_URL" ]] && RENEW_URL="https://t.me/${TELEGRAM_BOT}"; fi
  edit SUPPORT_URL "Support URL (https:// or tg://)"; edit RENEW_URL "Renew URL (https:// or tg://)"
  edit ACCENT "Accent color (#RRGGBB)"; edit LOGO_URL "Logo URL (https://… image)"; edit NOTICE "Notice shown at top (optional)"
  url_ok "$SUPPORT_URL" && url_ok "$RENEW_URL" || echo -e "${YELLOW}Invalid URL(s) will be ignored${NC}"
  save_cfg
  [[ -f "$XUI_FILE" ]] && inject_theme "$XUI_FILE" && echo -e "${GREEN}Updated 3x-ui theme${NC}"
  [[ -f "$(pg_file)" ]] && inject_theme "$(pg_file)" && echo -e "${GREEN}Updated PasarGuard theme${NC}"; return 0; }
status(){ echo -e "${CYAN}Status (v${VERSION}, ref ${REF})${NC}"
  [[ -f "$XUI_FILE" ]] && echo -e "3x-ui: ${GREEN}installed${NC}" || echo -e "3x-ui: ${YELLOW}no${NC}"
  [[ -f "$(pg_file)" ]] && echo -e "PasarGuard: ${GREEN}installed${NC} ($(pg_file))" || echo -e "PasarGuard: ${YELLOW}no${NC}"
  load_cfg; echo "Title: ${PROFILE_TITLE:-none} | Bot: ${TELEGRAM_BOT:-none} | Support: ${SUPPORT_URL:-none}"; }
self_update(){ local tmp; tmp="$(mktemp)"; fetch "${BASE}/nxt-sub" "$tmp" || die "Download failed"
  verify_sum "$tmp" nxt-sub || die "Aborted"; head -1 "$tmp" | grep -q '^#!/usr/bin/env bash' || die "Invalid CLI file"
  bash -n "$tmp" || die "Syntax check failed"; install -m 755 "$tmp" /usr/local/bin/nxt-sub; rm -f "$tmp"; echo -e "${GREEN}CLI updated${NC}"; }
uninstall_all(){ confirm "Remove both themes, CLI and config?" || return 0
  rm -f "$XUI_FILE" "$(pg_file)" /usr/local/bin/nxt-sub /usr/bin/nxt-sub; rm -rf "$CFG_DIR"
  command -v pasarguard >/dev/null 2>&1 && pasarguard restart || true; echo -e "${GREEN}Full uninstall done (backups *.bak.* kept)${NC}"; }

# ---------- CLI args ----------
LOCAL_FILE=""
args=("$@"); for ((i=0;i<${#args[@]};i++)); do [[ "${args[i]}" == "--file" ]] && LOCAL_FILE="${args[i+1]:-}"; done
case "${1:-}" in
  install) case "${2:-}" in xui|3xui) install_xui;; pg|pasarguard) install_pg;; *) die "usage: nxt-sub install xui|pg [--file theme.html]";; esac; exit 0;;
  restore) case "${2:-}" in xui|3xui) restore_latest "$XUI_FILE";; pg|pasarguard) restore_latest "$(pg_file)" && { command -v pasarguard >/dev/null 2>&1 && pasarguard restart || true; };; *) die "usage: nxt-sub restore xui|pg";; esac; exit 0;;
  status) status; exit 0;; update) self_update; exit 0;; version|-v|--version) echo "$VERSION"; exit 0;;
  "") ;; *) die "usage: nxt-sub [install xui|pg | restore xui|pg | status | update | version]";;
esac

echo -e "${CYAN}\n  ========================================\n       NexusNet Sub Manager  v${VERSION}\n  ========================================${NC}"
cat <<'MENU'
  1) Install / Update  3x-ui theme
  2) Install / Update  PasarGuard theme
  3) Settings (title / bot / support / renew / accent / logo / notice)
  4) Restore previous 3x-ui theme (from backup)
  5) Restore previous PasarGuard theme (from backup)
  6) Remove 3x-ui theme
  7) Remove PasarGuard theme
  8) Status
  9) Update this CLI
 10) Full uninstall
  0) Exit
MENU
c="$(ask 'Choice: ')"
case "$c" in
  1) install_xui;; 2) install_pg;; 3) settings_menu;;
  4) restore_latest "$XUI_FILE";; 5) restore_latest "$(pg_file)" && { command -v pasarguard >/dev/null 2>&1 && pasarguard restart || true; };;
  6) confirm "Remove 3x-ui theme?" && rm -f "$XUI_FILE" && echo -e "${GREEN}Removed${NC}";;
  7) confirm "Remove PasarGuard theme?" && rm -f "$(pg_file)" && { command -v pasarguard >/dev/null 2>&1 && pasarguard restart || true; echo -e "${GREEN}Removed${NC}"; };;
  8) status;; 9) self_update;; 10) uninstall_all;; 0) exit 0;; *) die "Invalid";;
esac
